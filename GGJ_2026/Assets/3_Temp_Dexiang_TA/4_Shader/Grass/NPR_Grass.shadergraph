    "m_SourceType": 1,
    "m_FunctionName": "SampleShadow",
    "m_FunctionSource": "",
    "m_FunctionBody": "#if defined(SHADERGRAPH_PREVIEW)\r\n    shadow = 1.0;\r\n#else\r\n    float4 shadowCoord = TransformWorldToShadowCoord(positionWS);\r\n    shadow = SAMPLE_TEXTURE2D_SHADOW(_MainLightShadowmapTexture, sampler_MainLightShadowmapTexture, shadowCoord.xyz);\r\n#endif"
}

